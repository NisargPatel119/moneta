# Copy this file to .env.local (local dev) and add the same values in
# Vercel → Project → Settings → Environment Variables (production).

# --- Required -------------------------------------------------------------

# The password you'll sign in with. Use something long and unique:
# anyone with this password can see your finances.
APP_PASSWORD=

# Plaid connects to your banks. Free "Trial" plan: https://dashboard.plaid.com/signup
# Keys: Plaid Dashboard → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox = fake test banks (user_good / pass_good), production = your real accounts.
# Note: Plaid's sandbox and production secrets are different.
PLAID_ENV=sandbox

# Postgres connection string. Free Neon database: https://neon.tech
# (or add Neon from the Vercel Marketplace, which fills this in for you)
DATABASE_URL=

# --- Optional -------------------------------------------------------------

# Lets Vercel Cron sync your accounts once a day (see vercel.json), so transaction history
# and the net worth chart keep building even on days you don't open the app.
# Any long random string, e.g. from: openssl rand -hex 32
CRON_SECRET=

# Enables the "Ask AI" tab. Free key, no credit card: https://console.groq.com/keys
# Tip: turn on Zero Data Retention under Settings → Data Controls.
GROQ_API_KEY=
# Any chat model your Groq key can use (see https://console.groq.com/docs/models)
# GROQ_MODEL=openai/gpt-oss-120b

# Helps banks that sign in on their own site (Chase, Capital One, …) work on phones.
# Must be HTTPS and added under Plaid Dashboard → Developers → API → Allowed redirect URIs.
# PLAID_REDIRECT_URI=https://your-app.vercel.app/oauth

# Shows made-up demo data with no login, Plaid, or database. For a separate public demo
# deployment only (never set it on the deployment that holds your real accounts).
# Locally you can just run: npm run demo
# DEMO_MODE=true
